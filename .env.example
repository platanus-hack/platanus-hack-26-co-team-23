# Supabase (Task 0 Step 2 — create project on supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (auth + organizations — replaces Supabase Auth for login).
# Linked app: CumplAI (app_3IGYo5UOL2tYGSklhjEzgeOveO6). These two keys
# are secret — get them with `clerk init --app app_3IGYo5UOL2tYGSklhjEzgeOveO6`
# (`clerk auth login` first), never copy them from another .env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/settings
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/settings

# Claude API (structuring + impact + PRO)
ANTHROPIC_API_KEY=

# Classic PAT with repo scope, from an account with access to the demo repo (Task 7 / PRO).
# Demo mode only: one account for every repo. In multi-client mode the GitHub App takes over.
GITHUB_TOKEN=

# "complAI" GitHub App — per-client credential (PRO). The client installs it on their
# repos and we store the installation_id in companies.github_installation_id.
# The private key goes on one line, with literal \n's.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_STATE_SECRET=
GITHUB_APP_SLUG=complia-app

# Our own secret for the /api/cron/* endpoints (made up, any long string)
CRON_SECRET=

# Email (Task 5)
RESEND_API_KEY=

# Wow channels (Task 5b)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=

# Bootstrap/demo master key for MCP access (rotatable)
MASTER_API_KEY=
