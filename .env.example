# Supabase (Task 0 Step 2 — crear proyecto en supabase.com, habilitar Google provider)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (estructuración + impacto + PRO)
ANTHROPIC_API_KEY=

# PAT clásico con scope repo, de cuenta con acceso al repo demo (Task 7 / PRO).
# Solo modo demo: una cuenta para todos los repos. En multi-cliente manda la GitHub App.
GITHUB_TOKEN=

# GitHub App "CumplIA" — credencial por cliente (PRO). El cliente la instala en sus
# repos y guardamos el installation_id en companies.github_installation_id.
# La private key va en una línea, con \n literales.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_STATE_SECRET=
GITHUB_APP_SLUG=complia-app

# Secreto propio para los endpoints /api/cron/* (inventado, cualquier string largo)
CRON_SECRET=

# Email (Task 5)
RESEND_API_KEY=

# Canales wow (Task 5b)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
