# Supabase (Task 0 Step 2 — crear proyecto en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (auth + organizaciones — reemplaza Supabase Auth para login).
# App vinculada: CumplAI (app_3IGYo5UOL2tYGSklhjEzgeOveO6). Estas dos claves
# son secretas — obtenlas con `clerk init --app app_3IGYo5UOL2tYGSklhjEzgeOveO6`
# (`clerk auth login` primero), nunca las copies de otro .env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/settings
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/settings

# Claude API (estructuración + impacto + PRO)
ANTHROPIC_API_KEY=

# PAT clásico con scope repo, de cuenta con acceso al repo demo (Task 7 / PRO)
GITHUB_TOKEN=

# Secreto propio para los endpoints /api/cron/* (inventado, cualquier string largo)
CRON_SECRET=

# Email (Task 5)
RESEND_API_KEY=

# Canales wow (Task 5b)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
RETELL_API_KEY=
