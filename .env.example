# Supabase (Task 0 Step 2 — crear proyecto en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (auth + organizaciones — reemplaza Supabase Auth para login).
# App vinculada: CumplAI (app_3IGYo5UOL2tYGSklhjEzgeOveO6). Estas dos claves
# son secretas — obtenlas con `clerk init --app app_3IGYo5UOL2tYGSklhjEzgeOveO6`
# (`clerk auth login` primero), nunca las copies de otro .env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/settings
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/settings

# Claude API (estructuración + impacto + PRO)
ANTHROPIC_API_KEY=

# PAT clásico con scope repo, de cuenta con acceso al repo demo (Task 7 / PRO).
# Solo modo demo: una cuenta para todos los repos. En multi-cliente manda la GitHub App.
GITHUB_TOKEN=

# GitHub App "complAI" — credencial por cliente (PRO). El cliente la instala en sus
# repos y guardamos el installation_id en companies.github_installation_id.
# La private key va en una línea, con \n literales.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_STATE_SECRET=
GITHUB_APP_SLUG=complia-app

# Secreto propio para los endpoints /api/cron/* (inventado, cualquier string largo)
CRON_SECRET=

# Email (Task 5)
RESEND_API_KEY=

# Canales wow (Task 5b)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=

# Key maestra de bootstrap/demo para el acceso MCP (rotable)
MASTER_API_KEY=
